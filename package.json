{
  "name": "snipvox",
  "version": "0.8.0",
  "private": true,
  "description": "Ultra-fast, open-source silence remover for video and audio. Desktop + mobile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aciderix/video-cutter.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "desktop:dev": "pnpm --filter @snipvox/desktop dev",
    "desktop:build": "pnpm --filter @snipvox/desktop build",
    "mobile:dev": "pnpm --filter @snipvox/mobile dev",
    "mobile:build": "pnpm --filter @snipvox/mobile build",
    "branding:sync": "bash scripts/branding-sync.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.4",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.22.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
