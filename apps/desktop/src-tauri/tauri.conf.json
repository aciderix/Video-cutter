{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Quietcut",
  "version": "0.4.0",
  "identifier": "app.quietcut.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quietcut",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "category": "Video",
    "shortDescription": "Ultra-fast silence remover",
    "longDescription": "Open-source video and audio editor focused on detecting and removing silences. Exports to single file, segmented files, or NLE-compatible formats (FCPXML, OTIO, EDL, etc.).",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
