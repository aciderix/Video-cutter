{
  "name": "@snipvox/mobile",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm copy:ffmpeg && vite",
    "build": "pnpm copy:ffmpeg && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "copy:ffmpeg": "mkdir -p public/ffmpeg && cp node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.js public/ffmpeg/ && cp node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.wasm public/ffmpeg/",
    "cap": "cap",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm build && cap sync android && cap open android",
    "cap:ios": "pnpm build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/share": "^6.0.3",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@snipvox/core": "workspace:*",
    "@snipvox/exporters": "workspace:*",
    "@snipvox/timeline": "workspace:*",
    "@snipvox/ui": "workspace:*",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
